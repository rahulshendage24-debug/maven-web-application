pipeline{
    agent any
    stages{
        stage('code pull'){
            steps{
              git url: "https://github.com/rahulshendage24-debug/maven-web-application.git"
              echo "sucessfull pulled the code"
            }
        }
        stage('build with maven'){
            steps{
              sh "mvn clean package"
            }
        }
        stage('test'){
            steps{
              sh "mvn test"
            }
        }
                stage('build with the docker') {
            steps {
                // This securely injects your credentials into the shell script environment
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        # Clean up existing containers running on port 8081 safely
                        RUNNING=$(docker ps -q --filter "publish=8081")
                        if [ ! -z "$RUNNING" ]; then 
                            docker stop $RUNNING || true
                        fi
                        
                        ALL_CONTAINERS=$(docker ps -aq --filter "publish=8081")
                        if [ ! -z "$ALL_CONTAINERS" ]; then 
                            docker rm $ALL_CONTAINERS || true
                        fi
                        
                        docker rm -f my-web-app || true
                        
                        # Build the image using your exact verified repository path
                        docker build -t rahulshendage/java-app:version1 .
                        
                        # LOG IN TO DOCKER HUB FIRST
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        
                        # PUSH THE IMAGE (This will now succeed)
                        docker push rahulshendage/java-app:version1
                        
                        # Clean up local cache
                        docker image prune -f
                    '''
                }
            }
        }

        stage('deploy with kubernatives'){
            steps{
                 sh '''
                  kubectl apply -f deployment.yml
                  kubectl apply -f service.yml
                 '''
            }
        }
    }
}
